{
  "name": "@divi/my-friends",
  "version": "0.1.0",
  "description": "The Divi app from MyFriends",
  "license": "MIT",
  "author": "Adam Sivins <adam.sivins@gmail.com>",
  "engines": {
    "node": ">=25.0.0"
  },
  "scripts": {
    "preinstall": "node ./scripts/setup-env/index.js",
    "postinstall": "echo \"Nothing to see here\"",
    "npm:clean-up": "sudo rm -rf node_modules package-lock.json packages/**/node_modules apps/**/node_modules && npm cache clean --force",
    "start:docs:dev": "npm run start:dev -w @divi/docs",
    "start:docs:prod": "npm run start:prod -w @divi/docs",
    "build:docs:prod": "npm run build:docs -w @divi/docs",
    "docker:dev:build": "docker compose -f docker-compose.yml build",
    "docker:dev:build:fresh": "docker compose -f docker-compose.yml  build --no-cache",
    "docker:dev:up": "docker compose -f docker-compose.yml  up -d",
    "docker:dev:up:recreate": "docker compose -f docker-compose.yml  up -d --force-recreate",
    "docker:dev": "npm-run-all -s docker:dev:build docker:dev:up",
    "docker:dev:clean": "npm-run-all -s docker:dev:build:fresh docker:dev:up:recreate"
  },
  "workspaces": [
    "./apps/middleware",
    "./apps/mobile",
    "./packages/df-dux",
    "./packages/df-mocker",
    "./packages/df-utilities",
    "./packages/divi-docs",
    "./scripts/setup-env"
  ],
  "allowScripts": {
    "esbuild": true,
    "@heroui/shared-utils@2.1.12": true,
    "@carbon/icons-react@11.84.0": true,
    "@carbon/icon-helpers@10.78.0": true,
    "vue-demi@0.14.10": true
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.63.0"
  },
  "globalDependencies": {
    "@typescript-eslint/parser": "^8.42.0",
    "component_scaffold": "^0.6.0",
    "eslint": "^9.34.0",
    "storybook": "^9.1.5",
    "typescript": "~7.0.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "jest": "^30.1.3",
    "npm-run-all2": "^9.0.3"
  }
}