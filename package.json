{
  "name": "@divi",
  "version": "0.1.0",
  "description": "The Divi app from MyFriends",
  "license": "MIT",
  "author": "Adam Sivins <adam.sivins@gmail.com>",
  "engines": {
    "node": ">=25.0.0"
  },
  "scripts": {
    "preinstall": "node ./scripts/setup-env/index.js",
    "start:docs": "storybook dev -p 5175 -c ./packages/divi-docs/config --no-open",
    "build:docs": "storybook build -c ./packages/divi-docs/config"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "scripts/*"
  ],
  "allowScripts": {
    "esbuild": true,
    "@heroui/shared-utils@2.1.12": true,
    "@carbon/icons-react@11.84.0": true,
    "@carbon/icon-helpers@10.78.0": true,
    "vue-demi@0.14.10": true
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.63.0"
  },
  "globalDependencies": {
    "@typescript-eslint/parser": "^8.42.0",
    "component_scaffold": "^0.6.0",
    "eslint": "^9.34.0",
    "storybook": "^9.1.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4",
    "jest": "^30.1.3",
    "npm-run-all": "^4.1.5"
  }
}