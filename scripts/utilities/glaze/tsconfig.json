{
  "baseDir": "./src",
  "extends": "./../../../.common/config/typescript/tsconfig.node.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",

    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,

    "types": ["node"]
  },
  "typeRoots": ["node_modules/@types"],
  "exclude": ["node_modules", "dist/", "lib/"],
  "include": ["src/**/*"]
}
