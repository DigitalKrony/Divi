{
  "extends": [
    "./../../.common/config/typescript/tsconfig.node.json",
    "./../../.common/config/typescript/tsconfig.app.json"
  ],
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./lib",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": false,
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "typeRoots": ["node_modules/@types"],
  "include": ["./src/**/*"],
  "exclude": ["lib", "lib-cjs", "node_modules"]
}
